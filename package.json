{
  "name": "@raniagus/subjects-graph",
  "version": "0.3.0",
  "description": "Embeddable interactive university subject prerequisite graphs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaniAgus/subjects-graph.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "start": "pnpm dlx http-server public -p 8000 -c-1",
    "test": "vitest run",
    "test:integration": "bddgen && playwright test",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "build:lib": "node scripts/build-lib.mjs",
    "prepack": "pnpm run build:lib"
  },
  "keywords": [],
  "author": "",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.25.12",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "cytoscape": "3.33.1"
  }
}
